# Langfuse OTLP endpoint (defaults to localhost:4318 for local development)
# EU: https://cloud.langfuse.com/api/public/otel/v1/traces
# US: https://us.cloud.langfuse.com/api/public/otel/v1/traces
# Self-hosted: http://localhost:3000/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces

# Base64-encoded "public_key:secret_key" for Langfuse authentication
LANGFUSE_AUTH_BASE64=base64-of-public:secret
